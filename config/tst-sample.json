{
  "environment": "tst",
  "environmentName": "Test",
  "meshName": "meshName-test",
  "domains": [
    {
      "domainName": "SolaceSampleDomain",
      "applications": [
        {
          "name": "Application_1",
          "version": "0.1.0",
          "user": {
            "name": "app1-tst",
            "type": "solaceClientUsername",
            "password": "app1-tst"
          }
        },
        {
          "name": "Application_2",
          "version": "0.1.0",
          "user": {
            "name": "app2-tst",
            "type": "solaceClientCertificate",
            "clientProfileName": "[some predefined existing client profile template name]"
          }
        },
        {
          "name": "Application_3",
          "version": "0.1.0",
          "user": {
            "role": "app3_role",
            "name": "app3_tst",
            "type": "solaceAuthorizationGroup"
          }
        },
        {
          "name": "RDP_Application_1",
          "version": "0.1.0",
          "restConsumers": [
            {
              "restConsumerConfiguration": {
                "remoteHost": "[hostname]",
                "remotePort": 443,
                "tlsEnabled": true,
                "restConsumerName": "[consumer name]",
                "authenticationScheme": "aws",
                "authenticationAwsRegion": "[region]",
                "authenticationAwsService": "[service]",
                "authenticationAwsAccessKeyId": "[aws access key id]",
                "authenticationAwsSecretAccessKey": "[aws secret access key]"
              }
            }
          ]
        },
        {
          "name": "RDP_Application_1",
          "version": "0.1.0",
          "user": {
            "type": "solaceRdpConsumer",
            "restConsumerConfiguration": {
              "remoteHost": "[hostname]",
              "remotePort": 443,
              "tlsEnabled": true,
              "restConsumerName": "Generic Certificate",
              "authenticationScheme": "client-certificate",
              "authenticationClientCertContent": "[client cert content]",
              "authenticationClientCertPassword": "[client cert password]"
            }
          }
        }
      ]
    }
  ],
  "brokers": [ {
    "name": "brokerName",
    "url": "https://mr-connection-[brokerId].messaging.solace.cloud:943/SEMP/v2/config",
    "user": "mission-control-manager",
    "password": "<secret>",
    "msgVpnName": "vpnName"
  }]
}
